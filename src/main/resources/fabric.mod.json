{
  "schemaVersion": 1,
  "id": "universal_gui_animation",
  "version": "${version}",
  "name": "Universal GUI Animation",
  "description": "Selectable Vanilla+ entrance animations for Minecraft GUI screens, with adjustable bounce and squeeze.",
  "authors": [
    "Febri"
  ],
  "contact": {
    "sources": "https://github.com/djoleng0901-droid/Universal-GUI-Animation"
  },
  "license": "MIT",
  "environment": "client",
  "mixins": [
    "universal-gui-animation.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "dev.febri.guianimation.GuiAnimationClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
